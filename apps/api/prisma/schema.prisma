// Schéma de la base de l'application (distincte de la base Traccar).
// Les modèles User, Session, Account, Verification et TwoFactor sont ceux attendus par Better Auth.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ─── Clients (tenants) ────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED // impayé : accès bloqué, données conservées
  CANCELLED
}

model Tenant {
  id             String       @id @default(cuid())
  slug           String       @unique @db.VarChar(64) // utilisé dans /login/<slug>
  name           String       @db.VarChar(191)
  address        String?      @db.VarChar(500)
  phone          String?      @db.VarChar(32)
  email          String?      @db.VarChar(191)
  logoUrl        String?      @db.VarChar(500)
  primaryColor   String       @default("#1E3A8A") @db.VarChar(7)
  secondaryColor String       @default("#F59E0B") @db.VarChar(7)
  status         TenantStatus @default(ACTIVE)
  traccarGroupId Int?         @unique // groupe Traccar du client
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users      User[]
  vehicles   Vehicle[]
  commandLog CommandLog[]
  zones      Zone[]
  events     Event[]

  @@map("tenants")
}

// ─── Authentification (Better Auth) ───────────────────────────────────────────

enum Role {
  SUPER_ADMIN  // exploitant de la plateforme, sans tenant
  TENANT_ADMIN // admin du client : branding, utilisateurs, commandes moteur
  VIEWER       // lecture seule
}

model User {
  id               String    @id
  name             String    @db.VarChar(191)
  email            String    @unique @db.VarChar(191)
  emailVerified    Boolean   @default(false)
  image            String?   @db.VarChar(500)
  role             Role      @default(VIEWER)
  tenantId         String?
  traccarUserId    Int?      // utilisateur Traccar lié, si besoin
  twoFactorEnabled Boolean?  @default(false)
  // Mot de passe provisoire (créé ou réinitialisé par le super-admin) : à changer avant tout accès.
  mustChangePassword Boolean @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]
  pushTokens  PushToken[]
  commandLog  CommandLog[]
  auditLog    AuditLog[]

  @@index([tenantId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique @db.VarChar(191)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.Text
  // « Se connecter en tant que » : client au nom duquel le super-admin agit pendant cette session.
  actingTenantId String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(64)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String    @db.VarChar(255)
  backupCodes             String    @db.Text
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ─── Véhicules ────────────────────────────────────────────────────────────────

model Vehicle {
  id              String   @id @default(cuid())
  tenantId        String
  traccarDeviceId Int      @unique // un traceur n'appartient qu'à un seul client
  name            String   @db.VarChar(191)
  plate           String?  @db.VarChar(32)
  // Début de l'historique visible par le client (trajets, tracé, KPI). Par défaut l'affectation ;
  // le super-admin peut l'avancer (traceur neuf ou déjà chez ce client), jamais au profit d'un autre client.
  historyStartAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  commandLog CommandLog[]
  events     Event[]

  @@index([tenantId])
  @@map("vehicles")
}

// ─── Zones (geofences) ────────────────────────────────────────────────────────

// Zone circulaire d'un client (dépôt, chantier…). Notre base fait foi ; la zone est recopiée dans
// Traccar (geofence liée au groupe du client), qui produit les événements d'entrée et de sortie.
model Zone {
  id                String   @id @default(cuid())
  tenantId          String
  name              String   @db.VarChar(100)
  latitude          Float
  longitude         Float
  radiusM           Int      // rayon en mètres
  traccarGeofenceId Int      @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  events Event[]

  @@index([tenantId])
  @@map("zones")
}

// ─── Événements des véhicules (alertes) ───────────────────────────────────────

// Événements transmis par Traccar (entrée ou sortie de zone, excès de vitesse, contact, alarme…).
// Le nom du véhicule et de la zone sont copiés : l'événement reste lisible après leur suppression.
model Event {
  id             String   @id @default(cuid())
  tenantId       String
  vehicleId      String?
  vehicleName    String   @db.VarChar(191)
  traccarEventId Int      @unique // évite d'enregistrer deux fois un événement retransmis
  type           String   @db.VarChar(32) // voir EVENT_TYPES dans src/lib/events.ts
  eventTime      DateTime
  zoneId         String?
  zoneName       String?  @db.VarChar(100)
  latitude       Float?
  longitude      Float?
  speedKmh       Float?
  detail         String?  @db.VarChar(64) // type d'alarme Traccar (lowBattery, powerCut…)
  createdAt      DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  zone    Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventTime])
  @@index([vehicleId, eventTime])
  @@map("events")
}

// ─── Journal d'audit des commandes moteur ─────────────────────────────────────

enum EngineCommand {
  ENGINE_STOP
  ENGINE_RESUME
}

enum CommandStatus {
  SENT     // acceptée par Traccar
  REJECTED // refusée par le backend (droits, vitesse, fréquence)
  FAILED   // erreur Traccar ou réseau : la commande n'est pas partie
  UNCERTAIN // envoyée à Traccar sans réponse (délai dépassé, coupure) : peut-être transmise au traceur
}

model CommandLog {
  id              String        @id @default(cuid())
  tenantId        String
  userId          String
  // Vide si le véhicule a été retiré du client depuis : le journal reste lisible grâce aux copies ci-dessous.
  vehicleId       String?
  vehicleName     String?       @db.VarChar(191) // nom du véhicule au moment de la commande
  traccarDeviceId Int?          // traceur visé
  command         EngineCommand
  status          CommandStatus
  reason          String?       @db.VarChar(500) // motif du refus ou de l'échec
  lastKnownSpeed  Float?        // vitesse (km/h) au moment de la demande
  traccarResponse String?       @db.Text
  ipAddress       String?       @db.VarChar(64)
  createdAt       DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([vehicleId, createdAt])
  @@map("command_log")
}

// ─── Journal d'audit du back-office ───────────────────────────────────────────

// Actions d'administration (clients, traceurs, comptes, branding). Jamais de secret dans details.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   @db.VarChar(64)  // ex. tenant.create, vehicle.assign
  tenantId   String?  @db.VarChar(64)  // client concerné (pas de clé étrangère : le journal survit)
  targetId   String?  @db.VarChar(64)
  details    String?  @db.Text         // JSON
  ipAddress  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── Notifications push ───────────────────────────────────────────────────────

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

model PushToken {
  id         String       @id @default(cuid())
  userId     String
  token      String       @unique @db.VarChar(255)
  platform   PushPlatform
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}
