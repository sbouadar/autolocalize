// Schéma de la base de l'application (distincte de la base Traccar).
// Les modèles User, Session, Account, Verification et TwoFactor sont ceux attendus par Better Auth.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ─── Clients (tenants) ────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED // impayé : accès bloqué, données conservées
  CANCELLED
}

model Tenant {
  id             String       @id @default(cuid())
  slug           String       @unique @db.VarChar(64) // utilisé dans /login/<slug>
  name           String       @db.VarChar(191)
  address        String?      @db.VarChar(500)
  phone          String?      @db.VarChar(32)
  email          String?      @db.VarChar(191)
  logoUrl        String?      @db.VarChar(500)
  primaryColor   String       @default("#141414") @db.VarChar(7)
  secondaryColor String       @default("#F59E0B") @db.VarChar(7)
  status         TenantStatus @default(ACTIVE)
  traccarGroupId Int?         @unique // groupe Traccar du client
  // Réglages métier (plan des fonctions métier, M1) : devise des montants, fuseau des dates sans
  // heure et des alertes quotidiennes, modules activables par client.
  currency       Currency     @default(MAD)
  timezone       String       @default("Africa/Casablanca") @db.VarChar(64)
  rentalsEnabled Boolean      @default(false) // module location (réservations, départs et retours)
  driversEnabled Boolean      @default(false) // module conducteurs (flottes d'entreprise)
  rentalTerms    String?      @db.Text // conditions générales de location, reprises dans le contrat PDF
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users                   User[]
  vehicles                Vehicle[]
  commandLog              CommandLog[]
  zones                   Zone[]
  events                  Event[]
  odometerReadings        OdometerReading[]
  vehicleUnavailabilities VehicleUnavailability[]
  vehicleDeadlines        VehicleDeadline[]
  customers               Customer[]
  rentals                 Rental[]
  maintenancePlans        MaintenancePlan[]
  maintenanceRecords      MaintenanceRecord[]
  expenses                Expense[]

  @@map("tenants")
}

// Devise des montants d'un client (une seule, sans conversion).
enum Currency {
  MAD
  EUR
  USD
}

// ─── Authentification (Better Auth) ───────────────────────────────────────────

enum Role {
  SUPER_ADMIN // exploitant de la plateforme, sans tenant
  TENANT_ADMIN // admin du client : branding, utilisateurs, commandes moteur
  AGENT // employé du client : réservations, départs et retours, relevés, dépenses ; ni comptes, ni branding, ni coupure moteur
  VIEWER // lecture seule
}

model User {
  id                 String    @id
  name               String    @db.VarChar(191)
  email              String    @unique @db.VarChar(191)
  emailVerified      Boolean   @default(false)
  image              String?   @db.VarChar(500)
  role               Role      @default(VIEWER)
  tenantId           String?
  traccarUserId      Int? // utilisateur Traccar lié, si besoin
  twoFactorEnabled   Boolean?  @default(false)
  // Mot de passe provisoire (créé ou réinitialisé par un admin) : à changer avant tout accès.
  mustChangePassword Boolean   @default(false)
  // Compte désactivé par l'admin du client : sessions fermées, toute requête refusée.
  disabledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant     Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  pushTokens PushToken[]
  commandLog CommandLog[]
  auditLog   AuditLog[]

  @@index([tenantId])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique @db.VarChar(191)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.Text
  // « Se connecter en tant que » : client au nom duquel le super-admin agit pendant cette session.
  actingTenantId String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.VarChar(191)
  providerId            String    @db.VarChar(64)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(191)
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String    @db.VarChar(255)
  backupCodes             String    @db.Text
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ─── Véhicules ────────────────────────────────────────────────────────────────

model Vehicle {
  id              String    @id @default(cuid())
  tenantId        String
  traccarDeviceId Int       @unique // un traceur n'appartient qu'à un seul client
  name            String    @db.VarChar(191)
  plate           String?   @db.VarChar(32)
  // Début de l'historique visible par le client (trajets, tracé, KPI). Par défaut l'affectation ;
  // le super-admin peut l'avancer (traceur neuf ou déjà chez ce client), jamais au profit d'un autre client.
  historyStartAt  DateTime  @default(now())
  // Fiche du véhicule, renseignée par l'admin du client (tout est facultatif).
  brand           String?   @db.VarChar(64)
  model           String?   @db.VarChar(64)
  year            Int?
  vin             String?   @db.VarChar(32)
  fuelType        FuelType?
  color           String?   @db.VarChar(32)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  commandLog              CommandLog[]
  events                  Event[]
  zones                   ZoneVehicle[]
  odometerReadings        OdometerReading[]
  vehicleUnavailabilities VehicleUnavailability[]
  vehicleDeadlines        VehicleDeadline[]
  rentals                 Rental[]
  maintenancePlans        MaintenancePlan[]
  maintenanceRecords      MaintenanceRecord[]
  expenses                Expense[]

  @@index([tenantId])
  @@map("vehicles")
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  LPG
  OTHER
}

// Relevés du compteur kilométrique. Compteur estimé d'un véhicule = dernier relevé + distance GPS
// parcourue depuis (somme des trajets, faussés compris une fois recalculés). On ne se fie pas au
// totalDistance de Traccar seul : il est faussé par les sauts au point 0,0.
model OdometerReading {
  id        String         @id @default(cuid())
  tenantId  String
  vehicleId String
  readAt    DateTime
  km        Int
  source    OdometerSource
  rentalId  String? // relevé de départ ou de retour d'une location (module location)
  createdBy String? // utilisateur (pas de clé étrangère : le relevé survit au compte), vide si automatique
  createdAt DateTime       @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, readAt])
  @@index([tenantId])
  @@map("odometer_readings")
}

enum OdometerSource {
  MANUAL
  RENTAL_OUT
  RENTAL_IN
  MAINTENANCE
}

// ─── Indisponibilités et échéances administratives (M3) ──────────────────────

// Période pendant laquelle un véhicule ne peut pas être loué ni utilisé (entretien, réparation…).
model VehicleUnavailability {
  id                  String               @id @default(cuid())
  tenantId            String
  vehicleId           String
  startAt             DateTime
  endAt               DateTime? // vide = jusqu'à nouvel ordre
  reason              UnavailabilityReason
  notes               String?              @db.VarChar(500)
  maintenanceRecordId String? // si liée à un entretien (M4)
  createdBy           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startAt])
  @@index([tenantId, startAt])
  @@map("vehicle_unavailabilities")
}

enum UnavailabilityReason {
  MAINTENANCE
  REPAIR
  ACCIDENT
  OTHER
}

// Échéance administrative d'un véhicule. La renouveler = modifier expiresOn (les alertes repartent).
model VehicleDeadline {
  id             String       @id @default(cuid())
  tenantId       String
  vehicleId      String
  type           DeadlineType
  label          String?      @db.VarChar(100) // obligatoire si type = OTHER
  expiresOn      DateTime     @db.Date
  reference      String?      @db.VarChar(100) // n° de police, de procès-verbal…
  warnDaysBefore Int          @default(30)
  notes          String?      @db.VarChar(500)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresOn])
  @@index([vehicleId])
  @@map("vehicle_deadlines")
}

enum DeadlineType {
  INSURANCE
  TECHNICAL_INSPECTION
  ROAD_TAX
  REGISTRATION
  OTHER
}

// ─── Entretien (M4) ───────────────────────────────────────────────────────────

// Entretien périodique d'un véhicule, au kilométrage et/ou à la date (au moins un des deux
// intervalles). Prochaine échéance = dernier entretien + intervalle, la plus proche des deux.
model MaintenancePlan {
  id             String          @id @default(cuid())
  tenantId       String
  vehicleId      String
  type           MaintenanceType
  label          String?         @db.VarChar(100) // obligatoire si type = OTHER
  intervalKm     Int?
  intervalDays   Int?
  lastDoneAt     DateTime?       @db.Date
  lastDoneKm     Int?
  warnBeforeKm   Int             @default(1000)
  warnBeforeDays Int             @default(15)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  records MaintenanceRecord[]

  @@index([vehicleId])
  @@index([tenantId])
  @@map("maintenance_plans")
}

enum MaintenanceType {
  OIL_CHANGE
  TIRES
  BRAKES
  TIMING_BELT
  SERVICE
  BATTERY
  AIR_CONDITIONING
  OTHER
}

// Entretien réalisé. Rattaché à un plan, il en met à jour la date et le kilométrage de référence.
model MaintenanceRecord {
  id        String          @id @default(cuid())
  tenantId  String
  vehicleId String
  planId    String?
  type      MaintenanceType
  label     String?         @db.VarChar(100)
  doneOn    DateTime        @db.Date
  km        Int?
  garage    String?         @db.VarChar(191)
  notes     String?         @db.Text
  createdBy String
  createdAt DateTime        @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle  Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  plan     MaintenancePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  // Coût de l'entretien (M7) : dépense saisie avec lui, supprimée avec lui.
  expenses Expense[]

  @@index([vehicleId, doneOn])
  @@index([tenantId])
  @@map("maintenance_records")
}

// ─── Dépenses (M7) ────────────────────────────────────────────────────────────

// Dépense d'un véhicule, dans la devise du client. Le coût d'un entretien est une dépense liée à
// l'entretien réalisé (supprimée avec lui).
model Expense {
  id                  String          @id @default(cuid())
  tenantId            String
  vehicleId           String
  spentOn             DateTime        @db.Date
  category            ExpenseCategory
  amount              Decimal         @db.Decimal(12, 2)
  liters              Float? // carburant
  km                  Int? // compteur au moment de la dépense (information)
  maintenanceRecordId String?
  notes               String?         @db.VarChar(500)
  createdBy           String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceRecord MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)

  @@index([vehicleId, spentOn])
  @@index([tenantId, spentOn])
  @@index([maintenanceRecordId])
  @@map("expenses")
}

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  REPAIR
  INSURANCE
  TAX
  TOLL
  FINE
  PARKING
  CLEANING
  OTHER
}

// ─── Locataires et réservations (M5, module location) ────────────────────────

// Locataire (particulier ou société). Les numéros de pièce d'identité et de permis sont chiffrés par
// l'API (src/lib/crypto.ts) : la base seule ne les révèle pas.
model Customer {
  id               String          @id @default(cuid())
  tenantId         String
  kind             CustomerKind    @default(PERSON)
  name             String          @db.VarChar(191) // nom complet ou raison sociale
  phone            String?         @db.VarChar(32)
  email            String?         @db.VarChar(191)
  address          String?         @db.VarChar(500)
  birthDate        DateTime?       @db.Date
  idDocumentType   IdDocumentType?
  idDocumentEnc    String?         @db.VarChar(255) // n° de pièce, chiffré
  idDocumentLast4  String?         @db.VarChar(4) // 4 derniers caractères, pour l'affichage masqué
  idDocumentHash   String?         @db.Char(64) // HMAC du n° normalisé : recherche exacte et doublons
  licenseNumberEnc String?         @db.VarChar(255) // n° de permis, chiffré
  licenseLast4     String?         @db.VarChar(4)
  licenseExpiresOn DateTime?       @db.Date
  anonymizedAt     DateTime? // données personnelles effacées (droit à l'effacement)
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rentals Rental[]

  @@index([tenantId, name])
  @@index([tenantId, idDocumentHash])
  @@map("customers")
}

enum CustomerKind {
  PERSON
  COMPANY
}

enum IdDocumentType {
  NATIONAL_ID
  PASSPORT
  RESIDENCE_PERMIT
  OTHER
}

// Location d'un véhicule à un locataire. Le véhicule peut être retiré du client après coup : la
// location reste lisible grâce aux copies de son nom et de sa plaque.
model Rental {
  id             String       @id @default(cuid())
  tenantId       String
  vehicleId      String?
  vehicleName    String       @db.VarChar(191)
  vehiclePlate   String?      @db.VarChar(32)
  customerId     String
  driverName     String?      @db.VarChar(191) // si le conducteur n'est pas le locataire
  status         RentalStatus @default(RESERVED)
  startAt        DateTime // prévu
  endAt          DateTime // prévu
  pickedUpAt     DateTime? // départ réel
  returnedAt     DateTime? // retour réel
  odometerOutKm  Int?
  odometerInKm   Int?
  fuelOut        Int? // niveau en huitièmes (0 à 8)
  fuelIn         Int?
  gpsDistanceKm  Float? // distance GPS entre départ et retour, calculée au retour
  price          Decimal?     @db.Decimal(12, 2) // saisi à la main, dans la devise du client
  deposit        Decimal?     @db.Decimal(12, 2)
  allowedZoneId  String? // zone que le véhicule ne doit pas quitter
  pickupLocation String?      @db.VarChar(191) // lieu de prise en charge (agence ou saisie libre)
  returnLocation String?      @db.VarChar(191) // lieu de dépôt
  notes          String?      @db.Text
  createdBy      String
  cancelledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  rentalPhotos   RentalPhoto[]
  rentalContract RentalContract?

  @@index([tenantId, startAt])
  @@index([vehicleId, startAt])
  @@index([customerId])
  @@map("rentals")
}

// Photo d'état des lieux d'une location (départ ou retour). Fichier privé : jamais servi par une
// route publique, nom aléatoire généré par l'API, métadonnées EXIF retirées avant stockage.
model RentalPhoto {
  id        String      @id @default(cuid())
  tenantId  String
  rentalId  String
  phase     RentalPhase
  fileName  String      @db.VarChar(64)
  mimeType  String      @db.VarChar(32)
  sizeBytes Int
  caption   String?     @db.VarChar(191)
  createdBy String
  createdAt DateTime    @default(now())

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@map("rental_photos")
}

enum RentalPhase {
  PICKUP
  RETURN
}

// Contrat PDF généré au départ, puis figé : jamais régénéré (un contrat signé ne doit pas changer).
model RentalContract {
  id        String   @id @default(cuid())
  tenantId  String
  rentalId  String   @unique
  fileName  String   @db.VarChar(64)
  sha256    String   @db.Char(64) // empreinte du PDF
  createdBy String
  createdAt DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@map("rental_contracts")
}

enum RentalStatus {
  RESERVED
  ONGOING
  COMPLETED
  CANCELLED
}

// ─── Zones (geofences) ────────────────────────────────────────────────────────

// Zone circulaire d'un client (dépôt, chantier…). Notre base fait foi ; la zone est recopiée dans
// Traccar (geofence liée au groupe du client), qui produit les événements d'entrée et de sortie.
model Zone {
  id                String   @id @default(cuid())
  tenantId          String
  name              String   @db.VarChar(100)
  latitude          Float
  longitude         Float
  radiusM           Int // rayon en mètres
  color             String   @default("#2563EB") @db.VarChar(7) // couleur d'affichage, attribuée à la création
  traccarGeofenceId Int      @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  events   Event[]
  vehicles ZoneVehicle[]

  @@index([tenantId])
  @@map("zones")
}

// Véhicules surveillés par une zone : seuls ceux-là déclenchent une alerte en y entrant ou en en
// sortant (5 zones au plus par véhicule). Recopié dans Traccar (liaison appareil ↔ geofence).
model ZoneVehicle {
  zoneId    String
  vehicleId String
  createdAt DateTime @default(now())

  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([zoneId, vehicleId])
  @@index([vehicleId])
  @@map("zone_vehicles")
}

// ─── Événements des véhicules (alertes) ───────────────────────────────────────

// Événements transmis par Traccar (entrée ou sortie de zone, excès de vitesse, contact, alarme…).
// Le nom du véhicule et de la zone sont copiés : l'événement reste lisible après leur suppression.
model Event {
  id             String      @id @default(cuid())
  tenantId       String
  vehicleId      String?
  vehicleName    String      @db.VarChar(191)
  // Événement transmis par Traccar : son identifiant évite de l'enregistrer deux fois. Vide pour un
  // événement produit par l'API (échéance, entretien, location), dédoublonné par dedupKey.
  traccarEventId Int?        @unique
  source         EventSource @default(TRACCAR)
  dedupKey       String?     @unique @db.VarChar(191) // ex. « deadline:<id>:2026-12-31:J-30 »
  rentalId       String? // location concernée (module location)
  message        String?     @db.VarChar(255) // détail lisible d'un événement de l'API
  type           String      @db.VarChar(32) // voir EVENT_TYPES dans src/lib/events.ts
  eventTime      DateTime
  zoneId         String?
  zoneName       String?     @db.VarChar(100)
  latitude       Float?
  longitude      Float?
  speedKmh       Float?
  detail         String?     @db.VarChar(64) // type d'alarme Traccar (lowBattery, powerCut…)
  createdAt      DateTime    @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  zone    Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventTime])
  @@index([vehicleId, eventTime])
  @@map("events")
}

enum EventSource {
  TRACCAR // transmis par Traccar (event.forward.url)
  APP // produit par l'API (tâche planifiée)
}

// ─── Journal d'audit des commandes moteur ─────────────────────────────────────

enum EngineCommand {
  ENGINE_STOP
  ENGINE_RESUME
}

enum CommandStatus {
  SENT // acceptée par Traccar
  REJECTED // refusée par le backend (droits, vitesse, fréquence)
  FAILED // erreur Traccar ou réseau : la commande n'est pas partie
  UNCERTAIN // envoyée à Traccar sans réponse (délai dépassé, coupure) : peut-être transmise au traceur
}

model CommandLog {
  id              String        @id @default(cuid())
  tenantId        String
  userId          String
  // Vide si le véhicule a été retiré du client depuis : le journal reste lisible grâce aux copies ci-dessous.
  vehicleId       String?
  vehicleName     String?       @db.VarChar(191) // nom du véhicule au moment de la commande
  traccarDeviceId Int? // traceur visé
  command         EngineCommand
  status          CommandStatus
  reason          String?       @db.VarChar(500) // motif du refus ou de l'échec
  lastKnownSpeed  Float? // vitesse (km/h) au moment de la demande
  traccarResponse String?       @db.Text
  ipAddress       String?       @db.VarChar(64)
  createdAt       DateTime      @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([vehicleId, createdAt])
  @@map("command_log")
}

// ─── Journal d'audit du back-office ───────────────────────────────────────────

// Actions d'administration (clients, traceurs, comptes, branding). Jamais de secret dans details.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String   @db.VarChar(64) // ex. tenant.create, vehicle.assign
  tenantId  String?  @db.VarChar(64) // client concerné (pas de clé étrangère : le journal survit)
  targetId  String?  @db.VarChar(64)
  details   String?  @db.Text // JSON
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── Notifications push ───────────────────────────────────────────────────────

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

model PushToken {
  id         String       @id @default(cuid())
  userId     String
  token      String       @unique @db.VarChar(255)
  platform   PushPlatform
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}
