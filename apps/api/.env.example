# Copier en .env et compléter. Ne jamais committer .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# URL publique de l'application (origine de confiance pour les cookies)
PUBLIC_URL=http://localhost:3000

# Base de l'application (utilisateur MySQL dédié, distinct de la base Traccar)
DATABASE_URL=mysql://autolocalize:CHANGE_ME@127.0.0.1:3306/autolocalize

# Better Auth : chaîne aléatoire d'au moins 32 caractères (openssl rand -base64 48)
BETTER_AUTH_SECRET=CHANGE_ME

# Traccar : compte de service bff-service
TRACCAR_URL=http://127.0.0.1:8082
TRACCAR_TOKEN=CHANGE_ME
