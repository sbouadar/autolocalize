# Copier en .env et compléter. Ne jamais committer .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# URL publique de l'application (origine de confiance pour les cookies)
PUBLIC_URL=http://localhost:3000

# Base de l'application (utilisateur MySQL dédié, distinct de la base Traccar)
DATABASE_URL=mysql://autolocalize:CHANGE_ME@127.0.0.1:3306/autolocalize

# Better Auth : chaîne aléatoire d'au moins 32 caractères (openssl rand -base64 48)
BETTER_AUTH_SECRET=CHANGE_ME

# Traccar : compte de service bff-service
TRACCAR_URL=http://127.0.0.1:8082
TRACCAR_TOKEN=CHANGE_ME

# Événements transmis par Traccar (alertes). Dans traccar.xml :
#   event.forward.url    = http://127.0.0.1:3000/api/internal/traccar/events
#   event.forward.header = X-Events-Secret: <même valeur>
# Chaîne aléatoire d'au moins 32 caractères (openssl rand -hex 32). Absent : réception désactivée.
# TRACCAR_EVENTS_SECRET=CHANGE_ME

# Dossier des logos des clients (défaut : data/logos ; volume Docker « logos » en production)
# LOGO_DIR=data/logos

# Développement uniquement : origines supplémentaires autorisées (CORS + Better Auth),
# séparées par des virgules. Laisser vide en production.
# CORS_ORIGINS=http://localhost:8081

# Module location : chiffrement des numéros de pièce d'identité et de permis des locataires.
# Générer chacune avec « openssl rand -base64 32 ». À SAUVEGARDER hors du serveur : sans la clé de
# chiffrement, les numéros enregistrés sont perdus.
# DATA_ENCRYPTION_KEY=CHANGE_ME
# DATA_HASH_KEY=CHANGE_ME
