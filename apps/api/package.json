{
  "name": "@autolocalize/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev && prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx --env-file=.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/sensible": "6.0.7",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
